    # Illustrative legacy redirects inside the former host's site block.
    # This is not the live shared-proxy configuration. Exact regex boundaries
    # keep /beefsteak and /weatherwatcher outside these namespaces.
    @weatherwatch_legacy path_regexp weatherwatch_legacy ^/weatherwatch(?:/(.*))?$
    redir @weatherwatch_legacy https://weatherwatch.neutral.zone/{re.weatherwatch_legacy.1} 301

    @beef_legacy path_regexp beef_legacy ^/beef(?:/(.*))?$
    redir @beef_legacy https://weatherwatch.neutral.zone/{re.beef_legacy.1} 301
