[Unit]
# Continuous collection is a DEPLOYMENT choice, not a requirement of the data
# model: the collector is an observation instrument that may run in bounded
# sessions just as correctly. Running it continuously simply keeps rolling
# baselines contiguous and keeps replay as recovery machinery rather than
# normal operation.
Description=Weatherwatch - ATProto aggregate weather collector
Documentation=file:/opt/weatherwatch/deploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=weatherwatch
Group=weatherwatch
WorkingDirectory=/opt/weatherwatch
Environment=PYTHONDONTWRITEBYTECODE=1
# No --duration: run until stopped. The endpoint is written out in full and
# must match weatherwatch.collector.DEFAULT_ENDPOINT — changing it creates a
# hard observation seam by design, never a silent continuation.
# Console script, not `python -m`: WorkingDirectory is the repo root, and
# `python -m` prepends cwd to sys.path ahead of the editable install, so a stray
# `weatherwatch/` there silently shadows the real package (verified 2026-08-11).
# A console script's sys.path[0] is its own bin dir. PYTHONSAFEPATH would also
# fix it but is 3.11+; this host is 3.10.
ExecStart=/opt/weatherwatch/.venv/bin/weatherwatch \
    --db /var/lib/weatherwatch/weatherwatch.sqlite \
    collect --endpoint wss://jetstream1.us-east.bsky.network/subscribe

# systemd owns supervision: no shell loop, no in-process daemonising, no cron.
Restart=on-failure
RestartSec=15
# SIGTERM is handled: the collector closes its in-flight window as partial,
# flushes, and ends the run cleanly rather than losing it.
KillSignal=SIGTERM
TimeoutStopSec=45

MemoryHigh=512M
MemoryMax=1G
CPUQuota=50%
# NB: no OOMPolicy= — this host's systemd (v249) silently ignores it, and a
# directive that implies protection it does not provide is worse than none.
# Restart=on-failure already covers an OOM kill.

ProtectSystem=strict
ReadWritePaths=/var/lib/weatherwatch
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
