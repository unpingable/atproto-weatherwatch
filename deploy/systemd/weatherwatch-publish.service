[Unit]
# Deliberately NO After=/Requires= on the collector. Publication reads the
# aggregate database and must succeed whether or not collection is running;
# collection must continue whether or not publication ever runs again.
Description=Weatherwatch - regenerate and publish the static report
Documentation=file:/opt/weatherwatch/deploy/README.md

[Service]
Type=oneshot
User=weatherwatch
Group=weatherwatch
# Narrow, per-unit grant: group write on /var/www so the atomic directory
# swap can stage a sibling. Applies to this oneshot only — the collector
# never holds it, and no global group membership was changed.
SupplementaryGroups=labelwatch
WorkingDirectory=/opt/weatherwatch
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WW_MODE=local
Environment=WW_PY=/opt/weatherwatch/.venv/bin/python
# Render via the console script, not `python -m`. WorkingDirectory is the repo
# root, and `python -m` puts cwd on sys.path ahead of the editable install, so a
# stray package there shadows the real one. A console script's sys.path[0] is
# its own bin dir. (PYTHONSAFEPATH would do it too, but that is 3.11+ and this
# host is 3.10.)
Environment=WW_CLI=/opt/weatherwatch/.venv/bin/weatherwatch
Environment=WW_DB=/var/lib/weatherwatch/weatherwatch.sqlite
# The episode store AND the sealed field archive. Unset, the report
# renders the social section as unavailable and the conditions block as
# "Station offline" -- both honestly, and both permanently.
Environment=WW_SOCIAL_DB=/var/lib/weatherwatch/social.sqlite
Environment=WW_BUILD=/var/lib/weatherwatch/build/report
Environment=WW_TARGET=/var/www/weatherwatch
Environment=WW_PUBLIC_URL=https://weatherwatch.neutral.zone/
# The canonical, tested publication path: render -> privacy gate -> atomic
# swap. Not reimplemented here.
ExecStart=/opt/weatherwatch/deploy/publish.sh

ProtectSystem=strict
ReadWritePaths=/var/lib/weatherwatch /var/www
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
