[Unit]
Description=Weatherwatch - periodic social-weather field sealing
Documentation=file:/opt/weatherwatch/src/weatherwatch/social/field/README.md

[Timer]
# Six minutes: the longest whole-hour divisor that still meets the freshness
# rule the page publishes, with one missed run of margin.
#
# `conditions.STALE_AFTER_WINDOWS` is 15, and the deployed window is 60 s, so a
# reading older than 15 minutes is reported as `station_offline` — correctly,
# because that is what the criteria table says. This unit once ran HOURLY, so
# the public page truthfully reported the station offline for roughly 45
# minutes in every 60. The fix is to seal often enough to satisfy the declared
# semantics, not to redefine freshness around a cron entry.
#
# Margin: worst-case reading age at publish is one interval plus one run plus
# the window still filling, about 7.5 minutes against a 15-minute rule, so one
# run can fail before a reader is told the station is offline. A 15-minute
# cadence would put every cycle's tail past the rule: the page would read
# "Station offline" for the last minute or more of each cycle with nothing
# wrong. `tests/test_report.py` pins period * 2 < budget.
#
# Cost, measured 2026-10-19: a run is NOT free. Each run refits the
# climatology, and the refit moves its percentiles, so its id changes and every
# observation in the 30-day range is re-stamped with the new baseline evidence
# and rewritten -- ~205 MB of WAL per run on the deployed store (214 MB on a
# synthetic store at the same row counts). The store's close path checkpoints
# that log after each run (social/store.py), which bounds the file but not the
# writes. Making a run cost only its arrivals is an identity/evidence decision
# recorded in field/DECISIONS.md, not a timer setting.
#
# A wall-clock schedule, not `OnBootSec`+`OnUnitActiveSec`.
#
# That pair chains: each activation schedules the next, and the boot deadline
# is the seed. On a host up 173 days the boot deadline is long past, so a timer
# that is ever stopped and restarted comes back *enabled and active with no
# next elapse at all* — observed here, after the unit was disabled for four
# hours. A producer whose freshness guarantee depends on an unbroken activation
# chain is one `systemctl stop` away from silently never running again.
#
# `OnCalendar` is absolute: it recovers from any stop, restart or clock change,
# and the 30-second phase keeps it off the minute boundary the publish timer
# and everything else on this host cluster around, so the two oneshots do not
# contend for the same SQLite file.
OnCalendar=*:0/6:30
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
